# Auth TMDb (choisis une méthode)
TMDB_READ_TOKEN=
# TMDB_API_KEY=

# Options
TMDB_LANGUAGE=en-US
MAX_CANDIDATES=80
MAX_ITEMS=100
TMDB_TIMEOUT_MS=8000
SOURCE_TIMEOUT_MS=8000
RETRY_BASE_MS=250

# Active /debug/time, /debug/provider/:slug et /debug/airing/:id
DEBUG=false

# Cartes badges SVG dans les catalogues (recommandé)
RELEASE_CARDS=true
